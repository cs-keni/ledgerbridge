# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets to the repository.

# ── Required ────────────────────────────────────────────────────────────────────

# PostgreSQL password (used by Docker Compose db service and the api)
DB_PASSWORD=changeme

# JWT signing secret — must be at least 32 characters (256 bits) of random data.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-real-256-bit-secret-here

# ── Optional ─────────────────────────────────────────────────────────────────────

# Spring profile — leave blank for local dev, set to "demo" for Render demo deploy
SPRING_PROFILES_ACTIVE=

# Kafka bootstrap servers
# Local dev (docker-compose): localhost:9094 (external listener, default)
# Full docker-compose with api service: kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Grafana admin password (default: admin)
GRAFANA_PASSWORD=admin

# ── Supabase PostgreSQL (Phase 7.5 Render deploy) ────────────────────────────
# Use the DIRECT connection string (port 5432), NOT the PgBouncer pooler (6543).
# Flyway and JPA prepared statements require a direct connection.
# SPRING_DATASOURCE_URL=jdbc:postgresql://[project-id].supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# ── Upstash Kafka (Phase 7.5 Render deploy) ──────────────────────────────────
# SPRING_KAFKA_BOOTSTRAP_SERVERS=your-upstash-endpoint.upstash.io:9092
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="..." password="...";
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=PLAIN
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL
